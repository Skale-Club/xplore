# Public browser configuration for an existing Google Identity Platform project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Exact origin with scheme and port, no trailing slash. Set per environment.
APP_ORIGIN=http://localhost:3000

# Existing Supabase project; never create a new project for this migration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server only: the still-valid HS256 signing secret trusted by PostgREST/Storage.
# This is neither the service-role API key nor a new random application secret.
SUPABASE_JWT_SECRET=

# Existing maintenance job protection.
CRON_SECRET=
